/* ===========================================
   업보의 메아리 - 스타일시트
   =========================================== */
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap');

/* === 기본 리셋 === */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg-primary: #0d0d1a;
  --bg-secondary: #13131f;
  --bg-card: #1a1a2e;
  --bg-overlay: rgba(0, 0, 0, 0.85);
  --color-kill: #e63946;
  --color-talk: #4a90e2;
  --color-effect: #38b000;
  --color-tier-weak: #c8c8c8;
  --color-tier-mid: #f4a261;
  --color-tier-strong: #e63946;
  --color-gold: #ffd700;
  --color-text: #e8e8f0;
  --color-text-muted: #7a7a9a;
  --color-border: rgba(255, 255, 255, 0.1);
  --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.6);
  --shadow-glow-kill: 0 0 20px rgba(230, 57, 70, 0.4);
  --shadow-glow-talk: 0 0 20px rgba(74, 144, 226, 0.4);
  --shadow-glow-effect: 0 0 20px rgba(56, 176, 0, 0.4);
  --radius-card: 14px;
  --radius-sm: 8px;
  --font-serif: 'Noto Serif KR', serif;
  --font-sans: 'Noto Sans KR', sans-serif;
  --transition: 0.2s ease;
}

html,
body {
  height: 100%;
  font-family: var(--font-sans);
  background: var(--bg-primary);
  color: var(--color-text);
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}

/* === 화면 전환 === */
.screen {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.screen.active {
  display: flex;
}

/* === 배경 파티클 효과 === */
#title-screen {
  background: radial-gradient(ellipse at 50% 30%, #1f0528 0%, #0d0d1a 70%);
  overflow: hidden;
}

.bg-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 2px;
  height: 2px;
  background: var(--color-gold);
  border-radius: 50%;
  opacity: 0;
  animation: float-up linear infinite;
}

@keyframes float-up {
  0% {
    opacity: 0;
    transform: translateY(0) scale(1);
  }

  20% {
    opacity: 0.7;
  }

  80% {
    opacity: 0.5;
  }

  100% {
    opacity: 0;
    transform: translateY(-100vh) scale(0.3);
  }
}

/* === 타이틀 화면 === */
.title-content {
  text-align: center;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.title-logo {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 6vw, 4rem);
  font-weight: 700;
  color: var(--color-gold);
  text-shadow: 0 0 30px rgba(255, 215, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.8);
  letter-spacing: 0.08em;
  line-height: 1.1;
  animation: pulse-glow 3s ease-in-out infinite;
}

.title-sub {
  font-size: clamp(0.85rem, 2vw, 1rem);
  color: var(--color-text-muted);
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.karma-divider {
  width: 200px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  margin: 8px auto;
}

@keyframes pulse-glow {

  0%,
  100% {
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.8);
  }

  50% {
    text-shadow: 0 0 50px rgba(255, 215, 0, 0.8), 0 2px 6px rgba(0, 0, 0, 0.8);
  }
}

.title-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 24px;
  width: 220px;
}

/* === 버튼 공통 === */
.btn {
  padding: 14px 28px;
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition);
  letter-spacing: 0.05em;
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.05);
  opacity: 0;
  transition: opacity var(--transition);
}

.btn:hover::before {
  opacity: 1;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: linear-gradient(135deg, #c9a227, #f5d060);
  color: #0d0d1a;
  font-weight: 700;
  box-shadow: 0 4px 20px rgba(201, 162, 39, 0.4);
}

.btn-primary:hover {
  box-shadow: 0 6px 28px rgba(201, 162, 39, 0.6);
  transform: translateY(-2px);
}

.btn-secondary {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--color-text);
}

.btn-secondary:hover {
  border-color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.05);
}

.btn-danger {
  background: rgba(230, 57, 70, 0.2);
  border: 1px solid var(--color-kill);
  color: var(--color-kill);
}

.btn-danger:hover {
  background: rgba(230, 57, 70, 0.35);
}

.btn-talk {
  background: rgba(74, 144, 226, 0.2);
  border: 1px solid var(--color-talk);
  color: var(--color-talk);
}

.btn-talk:hover {
  background: rgba(74, 144, 226, 0.35);
}

.btn-sm {
  padding: 8px 16px;
  font-size: 0.85rem;
}

.btn-icon {
  width: 36px;
  height: 36px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 1.1rem;
}

/* === 인게임 화면 === */
#game-screen {
  background: linear-gradient(160deg, #0d0d1a 0%, #12071e 100%);
  display: none;
  flex-direction: column;
  overflow: hidden;
}

#game-screen.active {
  display: flex;
}

/* === 상단 바 === */
#top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: rgba(0, 0, 0, 0.5);
  border-bottom: 1px solid var(--color-border);
  gap: 12px;
  flex-shrink: 0;
}

.game-title-small {
  font-family: var(--font-serif);
  font-size: 1rem;
  color: var(--color-gold);
  font-weight: 700;
  white-space: nowrap;
}

.stats-row {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

.stat-chip {
  display: flex;
  align-items: center;
  gap: 5px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--color-border);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.82rem;
  white-space: nowrap;
}

.stat-label {
  color: var(--color-text-muted);
  font-size: 0.75rem;
}

.stat-value {
  font-weight: 700;
  font-size: 0.95rem;
}

.stat-hp .stat-value {
  color: #ff6b6b;
}

.stat-mp .stat-value {
  color: #74b9ff;
}

.stat-karma .stat-value {
  color: var(--color-gold);
}

.stat-turn .stat-value {
  color: #a8e6cf;
}

.stat-token .stat-value {
  color: #ffeaa7;
}

#menu-btn {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text);
  border-radius: var(--radius-sm);
  padding: 6px 12px;
  cursor: pointer;
  font-size: 0.85rem;
  transition: all var(--transition);
  white-space: nowrap;
  font-family: var(--font-sans);
}

#menu-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

/* === 게임 메인 영역 === */
#game-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 10px 14px;
  gap: 10px;
}

/* === 상대 영역 === */
#enemy-zone {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.zone-label {
  font-size: 0.72rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

/* === 현재 상대 카드 표시 === */
#current-enemy-display {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

#field-card-wrapper {
  position: relative;
}

/* === 덱 표시 영역 === */
#deck-zone {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-shrink: 0;
}

.deck-pile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}

.deck-mini {
  width: 48px;
  height: 68px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform var(--transition);
  border: 1px solid rgba(255, 255, 255, 0.15);
  position: relative;
}

.deck-mini:hover {
  transform: translateY(-2px);
}

.deck-mini.action-deck {
  background: linear-gradient(135deg, #1e2a4a, #2a3a6a);
  color: #74b9ff;
}

.deck-mini.discard-pile {
  background: linear-gradient(135deg, #2a1a1e, #3a2028);
  color: #ff9999;
  opacity: 0.7;
}

.deck-mini.enemy-deck {
  background: linear-gradient(135deg, #1e1a2a, #2e2a4a);
  color: #b39ddb;
}

.deck-mini.echo-deck {
  background: linear-gradient(135deg, #2a1a0a, #3a2a1a);
  color: var(--color-gold);
}

.deck-count {
  position: absolute;
  top: 3px;
  right: 3px;
  font-size: 0.7rem;
  opacity: 0.9;
}

.deck-mini-label {
  font-size: 0.62rem;
  color: var(--color-text-muted);
  text-align: center;
}

/* === 로그 영역 === */
#log-zone {
  flex: 1;
  overflow-y: auto;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  min-height: 80px;
  max-height: 120px;
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--color-text-muted);
}

#log-zone p {
  margin-bottom: 2px;
}

#log-zone p.log-event {
  color: var(--color-gold);
}

#log-zone p.log-danger {
  color: var(--color-kill);
}

#log-zone p.log-success {
  color: var(--color-effect);
}

#log-zone p.log-talk {
  color: var(--color-talk);
}

/* === 행동 버튼 영역 === */
#action-zone {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-shrink: 0;
  flex-wrap: wrap;
}

#action-zone .btn {
  flex: 1;
  min-width: 80px;
  font-size: 0.88rem;
  padding: 10px 12px;
}

/* === 손패 영역 === */
#hand-zone {
  display: flex;
  gap: 8px;
  align-items: flex-end;
  overflow-x: auto;
  flex-shrink: 0;
  padding: 6px 0 4px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
}

#hand-zone::-webkit-scrollbar {
  height: 4px;
}

#hand-zone::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
}

/* === 카드 === */
.card {
  position: relative;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  flex-shrink: 0;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}

/* 행동 카드 크기 */
.card-action {
  width: 90px;
  height: 130px;
}

/* 상대 카드 크기 */
.card-enemy {
  width: 110px;
  height: 155px;
}

/* 필드 카드 (크게) */
.card-field {
  width: 120px;
  height: 170px;
}

.card:hover {
  transform: translateY(-6px) scale(1.03);
}

.card.selected {
  transform: translateY(-10px) scale(1.05);
}

/* 카드 타입별 테두리/배경 */
.card-action.kill {
  background: linear-gradient(160deg, #1e0a0a, #2e1010);
  border: 1.5px solid rgba(230, 57, 70, 0.5);
}

.card-action.talk {
  background: linear-gradient(160deg, #0a101e, #10182e);
  border: 1.5px solid rgba(74, 144, 226, 0.5);
}

.card-action.effect {
  background: linear-gradient(160deg, #0a1e0a, #102e10);
  border: 1.5px solid rgba(56, 176, 0, 0.5);
}

.card-action.kill:hover {
  box-shadow: var(--shadow-glow-kill);
}

.card-action.talk:hover {
  box-shadow: var(--shadow-glow-talk);
}

.card-action.effect:hover {
  box-shadow: var(--shadow-glow-effect);
}

/* 상대 카드 */
.card-enemy.tier-weak {
  background: linear-gradient(160deg, #1a1a1a, #2a2a2a);
  border: 1.5px solid rgba(200, 200, 200, 0.4);
}

.card-enemy.tier-mid {
  background: linear-gradient(160deg, #1e1408, #2e2010);
  border: 1.5px solid rgba(244, 162, 97, 0.5);
}

.card-enemy.tier-strong {
  background: linear-gradient(160deg, #1e0808, #2e1010);
  border: 1.5px solid rgba(230, 57, 70, 0.6);
}

/* === 카드 내부 구성 === */
.card-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 7px;
  gap: 4px;
}

/* 카드 헤더 (구분 표시 + 이름) */
.card-header {
  display: flex;
  align-items: center;
  gap: 5px;
}

.card-type-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.kill .card-type-dot {
  background: var(--color-kill);
  box-shadow: 0 0 6px var(--color-kill);
}

.talk .card-type-dot {
  background: var(--color-talk);
  box-shadow: 0 0 6px var(--color-talk);
}

.effect .card-type-dot {
  background: var(--color-effect);
  box-shadow: 0 0 6px var(--color-effect);
}

.card-name {
  font-family: var(--font-serif);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

/* 카드 이미지 영역 */
.card-image-area {
  flex: 1;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px dashed rgba(255, 255, 255, 0.1);
  position: relative;
}

.card-image-area img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 4px;
}

.card-image-placeholder {
  font-size: 0.58rem;
  color: rgba(255, 255, 255, 0.2);
  text-align: center;
  padding: 4px;
  line-height: 1.3;
}

/* 카드 하단 정보 */
.card-footer {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.card-cost {
  font-size: 0.68rem;
  color: #74b9ff;
  font-weight: 600;
}

.card-desc {
  font-size: 0.58rem;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 상대 카드 내 스탯 */
.enemy-stats {
  display: flex;
  justify-content: space-between;
  gap: 4px;
  margin-bottom: 2px;
}

.enemy-stat {
  font-size: 0.72rem;
  font-weight: 700;
}

.enemy-stat.r-stat {
  color: var(--color-talk);
}

.enemy-stat.a-stat {
  color: var(--color-kill);
}

.enemy-echo {
  font-size: 0.58rem;
  color: var(--color-gold);
  background: rgba(255, 215, 0, 0.08);
  border-radius: 4px;
  padding: 2px 4px;
  line-height: 1.3;
}

/* 티어 배지 */
.tier-badge {
  position: absolute;
  top: 5px;
  right: 6px;
  font-size: 0.58rem;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 4px;
}

.tier-weak .tier-badge {
  background: rgba(200, 200, 200, 0.15);
  color: var(--color-tier-weak);
}

.tier-mid .tier-badge {
  background: rgba(244, 162, 97, 0.15);
  color: var(--color-tier-mid);
}

.tier-strong .tier-badge {
  background: rgba(230, 57, 70, 0.2);
  color: var(--color-tier-strong);
}

/* === 카드 줌 모달 === */
#card-zoom-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.85);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  animation: fade-in 0.15s ease;
}

#card-zoom-modal.active {
  display: flex;
}

.card-zoom-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.card-zoom-inner {
  width: min(260px, 80vw);
  height: min(380px, 75vh);
  position: relative;
}

.card-zoom-inner .card {
  width: 100%;
  height: 100%;
  cursor: default;
}

.card-zoom-inner .card:hover {
  transform: none;
}

.card-zoom-inner .card-name {
  font-size: 1rem;
}

.card-zoom-inner .card-cost {
  font-size: 0.82rem;
}

.card-zoom-inner .card-desc {
  font-size: 0.75rem;
  -webkit-line-clamp: 6;
}

.card-zoom-inner .card-image-placeholder {
  font-size: 0.72rem;
}

.card-zoom-actions {
  display: flex;
  gap: 10px;
}

#zoom-play-btn {
  min-width: 120px;
}

#zoom-cancel-btn {
  min-width: 90px;
}

/* === 인게임 메뉴 === */
#ingame-menu {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 150;
  background: rgba(0, 0, 0, 0.75);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

#ingame-menu.active {
  display: flex;
}

.ingame-menu-box {
  background: #1a1a2e;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  padding: 32px 24px;
  width: min(300px, 90vw);
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
}

.ingame-menu-title {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  color: var(--color-gold);
  text-align: center;
  margin-bottom: 8px;
}

/* === 도움말 화면 === */
#help-screen {
  background: rgba(0, 0, 0, 0.92);
  z-index: 100;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 20px;
  overflow-y: auto;
}

.help-content {
  max-width: 600px;
  width: 100%;
  margin: 0 auto;
}

.help-content h2 {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  color: var(--color-gold);
  margin-bottom: 20px;
  text-align: center;
}

.help-content h3 {
  font-size: 1rem;
  color: var(--color-gold);
  margin: 18px 0 8px;
  border-bottom: 1px solid rgba(255, 215, 0, 0.2);
  padding-bottom: 4px;
}

.help-content p,
.help-content li {
  font-size: 0.88rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin-bottom: 4px;
}

.help-content ul {
  padding-left: 18px;
}

.help-content .highlight {
  color: var(--color-text);
  font-weight: 500;
}

.help-close-btn {
  margin: 20px auto 0;
  display: block;
}

/* === 결과 화면 === */
#result-screen {
  z-index: 120;
  background: radial-gradient(ellipse at 50% 50%, #0d0a1a 0%, #0d0d1a 100%);
}

.result-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.result-title {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 8vw, 4.5rem);
  font-weight: 700;
  animation: pulse-glow 2s infinite;
}

.result-win .result-title {
  color: var(--color-gold);
}

.result-lose .result-title {
  color: var(--color-kill);
}

.result-subtitle {
  font-size: 1rem;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
}

.result-stats {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 16px 24px;
  font-size: 0.9rem;
  line-height: 2;
}

.result-buttons {
  display: flex;
  gap: 12px;
}

/* === 주사위 === */
.dice-container {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: center;
  margin: 8px 0;
}

.die {
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.08);
  border: 1.5px solid rgba(255, 255, 255, 0.25);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-text);
  position: relative;
  animation: roll-in 0.35s ease;
}

.die.success {
  border-color: var(--color-effect);
  color: var(--color-effect);
  box-shadow: 0 0 12px rgba(56, 176, 0, 0.4);
}

.die.fail {
  border-color: var(--color-kill);
  color: var(--color-kill);
}

@keyframes roll-in {
  from {
    transform: rotate(-180deg) scale(0.4);
    opacity: 0;
  }

  to {
    transform: rotate(0) scale(1);
    opacity: 1;
  }
}

/* === 메아리 공개 패널 === */
#echo-panel {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  background: linear-gradient(0deg, #0d0a00, #1a1300);
  border-top: 2px solid var(--color-gold);
  padding: 14px 16px;
  animation: slide-up 0.3s ease;
  max-height: 220px;
  overflow-y: auto;
}

#echo-panel.active {
  display: block;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.echo-panel-title {
  font-family: var(--font-serif);
  color: var(--color-gold);
  font-size: 0.9rem;
  margin-bottom: 8px;
}

.echo-cards-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
}

/* === 토큰 선택 UI === */
#token-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 180;
  background: rgba(0, 0, 0, 0.8);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

#token-modal.active {
  display: flex;
}

.token-modal-box {
  background: #1a1a2e;
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 24px;
  width: min(340px, 92vw);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.token-modal-title {
  font-family: var(--font-serif);
  color: var(--color-gold);
  font-size: 1.1rem;
  text-align: center;
}

.token-count-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.token-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.06);
  color: var(--color-text);
  font-size: 1.3rem;
  cursor: pointer;
  transition: all var(--transition);
}

.token-btn:hover {
  background: rgba(255, 255, 255, 0.14);
}

.token-display {
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-gold);
  min-width: 40px;
  text-align: center;
}

/* === 빚쟁이 선택 모달 === */
#choice-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 175;
  background: rgba(0, 0, 0, 0.8);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
}

#choice-modal.active {
  display: flex;
}

.choice-modal-box {
  background: #1a1a2e;
  border: 1px solid var(--color-gold);
  border-radius: 16px;
  padding: 24px;
  width: min(320px, 90vw);
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: center;
}

.choice-modal-title {
  font-family: var(--font-serif);
  color: var(--color-gold);
  font-size: 1.1rem;
}

.choice-modal-desc {
  font-size: 0.85rem;
  color: var(--color-text-muted);
}

.choice-buttons {
  display: flex;
  gap: 10px;
}

.choice-buttons .btn {
  flex: 1;
}

/* === 공통 모달 === */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 160;
  background: rgba(0, 0, 0, 0.8);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
}

.modal-overlay.active {
  display: flex;
}

/* === 애니메이션 === */
@keyframes fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes shake {

  0%,
  100% {
    transform: translateX(0);
  }

  20% {
    transform: translateX(-6px);
  }

  40% {
    transform: translateX(6px);
  }

  60% {
    transform: translateX(-4px);
  }

  80% {
    transform: translateX(4px);
  }
}

.shake {
  animation: shake 0.4s ease;
}

@keyframes hp-flash {

  0%,
  100% {
    background: transparent;
  }

  50% {
    background: rgba(230, 57, 70, 0.25);
  }
}

/* === 카르마 바 === */
#karma-bar-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 16px;
  flex-shrink: 0;
}

.karma-bar-label {
  font-size: 0.72rem;
  color: var(--color-text-muted);
}

.karma-bar-track {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  overflow: hidden;
}

.karma-bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.4s ease, background 0.4s ease;
}

/* 모바일 반응형 */
@media (max-width: 480px) {
  .card-action {
    width: 78px;
    height: 112px;
  }

  .card-field {
    width: 100px;
    height: 142px;
  }

  .stats-row {
    gap: 6px;
  }

  .stat-chip {
    padding: 3px 8px;
    font-size: 0.76rem;
  }

  #action-zone .btn {
    padding: 8px 8px;
    font-size: 0.82rem;
  }
}

/* === 토스트 알림 === */
#toast {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: #1a1a2e;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  padding: 10px 20px;
  font-size: 0.85rem;
  color: var(--color-text);
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 300;
  white-space: nowrap;
}

#toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* === 손패 정리 UI === */
#discard-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 170;
  background: rgba(0, 0, 0, 0.72);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 20px;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

#discard-modal.active {
  display: flex;
}

.discard-modal-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  color: var(--color-gold);
  text-align: center;
}

.discard-modal-desc {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  text-align: center;
}

#discard-hand-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.card.discard-selected {
  outline: 2px solid var(--color-kill);
  outline-offset: 2px;
  transform: translateY(-8px) scale(1.06);
  box-shadow: 0 0 16px rgba(230, 57, 70, 0.5);
}

/* 버림 선택 가능 카드 hover */
#discard-hand-row .card:hover {
  transform: translateY(-6px) scale(1.04);
  cursor: pointer;
}

#discard-hand-row .card.discard-selected:hover {
  transform: translateY(-10px) scale(1.07);
}

/* === 날아다니는 카드 (애니메이션) === */
.fly-card {
  will-change: left, top, transform, opacity;
  border-radius: 10px !important;
  pointer-events: none !important;
}

/* 카드 사용 단계에서 손패의 카드에 hover 가이드 */
.card-play-phase .card-action:hover {
  box-shadow: 0 0 0 2px rgba(255, 215, 0, 0.5), var(--shadow-card);
}

/* 손패 정리 단계에서 카드 선택 가이드 표시 */
.hand-cleanup-hint {
  font-size: 0.72rem;
  color: var(--color-gold);
  text-align: center;
  padding: 4px 8px;
  background: rgba(255, 215, 0, 0.08);
  border-radius: 6px;
  border: 1px solid rgba(255, 215, 0, 0.2);
  margin-bottom: 6px;
}